package com.animequiz.game;

import java.util.Scanner;
import java.util.Random;

public class GuessTheAnime {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc=new Scanner(System.in);
		
		String[] anime = {"BLEACH","DEATH NOTE","DEMONS SLAYER","NARUTO","ONE PIECE"};
		String[] hint = {"Sword","Notebook kills","Zenitsu agatsuma","Ninja","Pirates"};
		Random r=new Random();
		int i=r.nextInt(anime.length);
		System.out.println("Guess the Anime");
		System.out.println("Hint: "+hint[i]);
		String guess=sc.nextLine();
		if(guess.equalsIgnoreCase(anime[i]))
			System.out.println("correct!"); 
		else
			System.out.println("Wrong! "+anime[i]); 
	}
}
